diff --git a/modules/video_output/apple/VLCDrawable.h b/modules/video_output/apple/VLCDrawable.h
index 0b0b6ee..e6e4a09 100644
--- a/modules/video_output/apple/VLCDrawable.h
+++ b/modules/video_output/apple/VLCDrawable.h
@@ -122,3 +122,23 @@
 /// The default implementation will return YES if not implemented
 - (BOOL)canStartPictureInPictureAutomaticallyFromInline;
 @end
+
+@class AVSampleBufferDisplayLayer;
+
+/**
+ * Protocol that lets the drawable provide a persistent, app-owned
+ * AVSampleBufferDisplayLayer for the samplebufferdisplay video output.
+ *
+ * When the drawable set via libvlc_media_player_set_nsobject() implements
+ * this protocol, the vout adopts the provided layer instead of creating its
+ * own display view/layer, and it does NOT create the built-in picture-in-
+ * picture controller (the app is expected to own PiP via the same layer).
+ * Because the layer belongs to the app, it survives vout close/reopen cycles
+ * (e.g. live-TS format changes), which keeps an active PiP session alive.
+ *
+ * The getter is called synchronously from the vout thread during Open —
+ * implementations must be thread-safe (immutable after init).
+ */
+@protocol VLCSampleBufferLayerProviding <NSObject>
+- (AVSampleBufferDisplayLayer *)vlc_providedSampleBufferLayer;
+@end
