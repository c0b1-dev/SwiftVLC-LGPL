+/* [Cobi 0007] Adds a Basic Proxy-Authorization from the proxy URL's userinfo
+ * ("http://user:pass@host:port"), the login tunnel.c already sends on CONNECT
+ * and the legacy http.c on every request. Asked before a connection is reused,
+ * so every request that goes to the proxy carries it, not only the first. */
+static int vlc_http_proxy_add_creds(struct vlc_http_msg *req,
+                                    const char *host, unsigned port)
+{
+    char *proxy = vlc_http_proxy_find(host, port, false);
+    if (proxy == NULL)
+        return 0;
+
+    vlc_url_t url;
+    int ret = 0;
+
+    vlc_UrlParse(&url, proxy);
+    free(proxy);
+    if (url.psz_username != NULL)
+        ret = vlc_http_msg_add_creds_basic(req, true, url.psz_username,
+                                           url.psz_password != NULL
+                                           ? url.psz_password : "");
+    vlc_UrlClean(&url);
+    return ret;
+}
