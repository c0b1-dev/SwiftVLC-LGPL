+#include <os/lock.h>
+
+/* [Cobi 0007] A proxy the host app sets for this process. iOS, tvOS and Mac
+ * Catalyst have no system proxy setting libVLC could read (below, the iPhone
+ * branch always returned NULL), so an app that routes its own traffic hands
+ * libVLC the address here. NULL = no app proxy: everything behaves as before.
+ * While one is set, EVERY http and https connection goes to it — never past it:
+ * if the proxy is down, the connection fails instead of going direct. */
+static os_unfair_lock app_proxy_lock = OS_UNFAIR_LOCK_INIT;
+static char *app_proxy_url = NULL;
+
+void vlc_darwin_SetProxyUrl(const char *proxy_url)
+{
+    char *copy = proxy_url != NULL ? strdup(proxy_url) : NULL;
+    os_unfair_lock_lock(&app_proxy_lock);
+    char *old = app_proxy_url;
+    app_proxy_url = copy;
+    os_unfair_lock_unlock(&app_proxy_lock);
+    free(old);
+}
+
+static char *app_proxy_for(const char *url)
+{
+    /* Only the schemes libVLC's HTTP stack tunnels: "http://" (absolute-URI
+     * forwarding) and "https://" (CONNECT). connmgr.c asks with exactly these. */
+    if (strncasecmp(url, "http://", 7) != 0 && strncasecmp(url, "https://", 8) != 0)
+        return NULL;
+    os_unfair_lock_lock(&app_proxy_lock);
+    char *proxy = app_proxy_url != NULL ? strdup(app_proxy_url) : NULL;
+    os_unfair_lock_unlock(&app_proxy_lock);
+    return proxy;
+}
+
 char *vlc_getProxyUrl(const char *url)
 {
     if (url == NULL) {
         return NULL;
     }
+    char *app_proxy = app_proxy_for(url);
+    if (app_proxy != NULL) {
+        return app_proxy;
+    }
