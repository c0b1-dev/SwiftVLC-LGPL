diff --git a/src/darwin/netconf.m b/src/darwin/netconf.m
index b0f0606e72..8ff4c13a3f 100644
--- a/src/darwin/netconf.m
+++ b/src/darwin/netconf.m
@@ -38,11 +38,113 @@
 #include <CoreServices/CoreServices.h>
 #endif
 
+#include <os/lock.h>
+#include <vlc_url.h>
+#include "../libvlc.h"
+
+/* [Cobi 0007] A proxy the host app sets for this process. iOS, tvOS and Mac
+ * Catalyst have no system proxy setting libVLC could read (below, the iPhone
+ * branch always returned NULL), so an app that routes its own traffic hands
+ * libVLC the address here. NULL = no app proxy: everything behaves as before.
+ *
+ * While one is set, libVLC never connects past it:
+ * - the schemes in app_proxy_routed go to it: "https" as CONNECT (tunnel.c),
+ *   the others as absolute-form requests (http/connmgr.c, legacy http.c for
+ *   icyx/unsv/itpc, mmsh.c). If it is down, they fail; nothing goes direct.
+ * - access_New() (src/input/access.c) refuses every scheme that is neither
+ *   routed nor in app_proxy_local, also after a redirect: the http module
+ *   turns ICY answers into icyx:// and "Pragma: features" into mmsh://, and a
+ *   Location may name any scheme (rtsp, ftp, smb, ...).
+ * A login in the URL ("http://user:pass@127.0.0.1:port", percent-encoded) goes
+ * to the proxy as Basic Proxy-Authorization on every request, so the proxy can
+ * turn away any other local process. The debug log never shows it. */
+static const char *const app_proxy_routed[] = {
+    "http", "https", "icyx", "unsv", "itpc", "mmsh", NULL
+};
+static const char *const app_proxy_local[] = {
+    "file", "fd", "stream", "directory", "dir", "concat", "list", "data",
+    "imem", "dummy", "vlc", NULL
+};
+
+/* Nothing listens on port 1: what a bad proxy URL is replaced with, so that
+ * it fails every connection instead of meaning "no proxy". */
+static const char app_proxy_closed[] = "http://127.0.0.1:1";
+
+static os_unfair_lock app_proxy_lock = OS_UNFAIR_LOCK_INIT;
+static const char *app_proxy_url = NULL; /* NULL, app_proxy_closed or malloc'd */
+
+static bool scheme_in(const char *scheme, size_t len, const char *const *list)
+{
+    for (; *list != NULL; list++)
+        if (strlen(*list) == len && strncasecmp(scheme, *list, len) == 0)
+            return true;
+    return false;
+}
+
+/* "http://[user:pass@]host:port[/]" and nothing else. An unencoded '/' or '?'
+ * in the login would make vlc_UrlParse() read a different host. */
+static bool app_proxy_valid(const char *proxy_url)
+{
+    vlc_url_t url;
+    bool ok = vlc_UrlParse(&url, proxy_url) == 0
+        && url.psz_protocol != NULL && strcasecmp(url.psz_protocol, "http") == 0
+        && url.psz_host != NULL && url.psz_host[0] != '\0'
+        && url.i_port > 0 && url.i_port <= 65535
+        && (url.psz_path == NULL || strcmp(url.psz_path, "/") == 0)
+        && url.psz_option == NULL && url.psz_fragment == NULL;
+    vlc_UrlClean(&url);
+    return ok;
+}
+
+void vlc_darwin_SetProxyUrl(const char *proxy_url)
+{
+    const char *value = NULL;
+    if (proxy_url != NULL)
+    {
+        char *copy = app_proxy_valid(proxy_url) ? strdup(proxy_url) : NULL;
+        value = copy != NULL ? copy : app_proxy_closed;
+    }
+    os_unfair_lock_lock(&app_proxy_lock);
+    const char *old = app_proxy_url;
+    app_proxy_url = value;
+    os_unfair_lock_unlock(&app_proxy_lock);
+    if (old != app_proxy_closed)
+        free((char *)old);
+}
+
+bool vlc_darwin_AppProxyAllowsScheme(const char *scheme)
+{
+    os_unfair_lock_lock(&app_proxy_lock);
+    bool set = app_proxy_url != NULL;
+    os_unfair_lock_unlock(&app_proxy_lock);
+    size_t len = strlen(scheme);
+    return !set || scheme_in(scheme, len, app_proxy_routed)
+                || scheme_in(scheme, len, app_proxy_local);
+}
+
+static char *app_proxy_for(const char *url)
+{
+    const char *colon = strchr(url, ':');
+    if (colon == NULL || !scheme_in(url, colon - url, app_proxy_routed))
+        return NULL;
+    os_unfair_lock_lock(&app_proxy_lock);
+    char *proxy = app_proxy_url != NULL ? strdup(app_proxy_url) : NULL;
+    bool lost = app_proxy_url != NULL && proxy == NULL;
+    os_unfair_lock_unlock(&app_proxy_lock);
+    if (unlikely(lost))
+        abort(); /* out of memory: NULL would mean "go direct" */
+    return proxy;
+}
+
 char *vlc_getProxyUrl(const char *url)
 {
     if (url == NULL) {
         return NULL;
     }
+    char *app_proxy = app_proxy_for(url);
+    if (app_proxy != NULL) {
+        return app_proxy;
+    }
 #if !TARGET_OS_IPHONE
     NSDictionary *proxySettings = CFBridgingRelease(CFNetworkCopySystemProxySettings());
     if (NULL != proxySettings) {
